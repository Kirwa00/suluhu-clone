{
  "name": "@suluhu/api-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Suluhu Therapy Center API — Cloudflare Workers port (Hono + Prisma/Hyperdrive).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate --schema ./prisma/schema.prisma --generator apiWorkerClient",
    "deploy": "wrangler deploy",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "@suluhu/shared": "1.0.0",
    "bcryptjs": "3.0.3",
    "hono": "4.13.13",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@types/pg": "8.23.1",
    "prisma": "6.19.3",
    "typescript": "5.6.3",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  }
}
