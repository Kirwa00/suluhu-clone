{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "suluhu-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [{ "pattern": "api.suluhutherapy.com", "custom_domain": true }],

  // Pooled Postgres connection to Neon, reached through Hyperdrive so the
  // Worker never holds a raw TCP pool itself. Create with:
  //   wrangler hyperdrive create suluhu-api-db --connection-string="<Neon pooled URL>"
  // then replace the placeholder id below (see apps/api-worker/README.md).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "4e5f168a051f4e099d967fade82bd0c6",
      // Used only by `wrangler dev` / `vitest` (Miniflare) — never by a real
      // deployment, which always goes through the `id` above. Same throwaway
      // dev credentials as docker-compose.yml / .env.example.
      "localConnectionString": "postgresql://suluhu:suluhu_dev_password@localhost:5432/suluhu_test?schema=public"
    }
  ],

  // Therapist credential documents (replaces LocalDocumentStorageService).
  // Wired in Phase 3; declared now so the binding exists from day one.
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "suluhu-documents"
    }
  ],

  // Reminder delivery (replaces BullMQ/Redis in modules/notifications). The
  // producer and consumer both live in this Worker. Wired in Phase 5.
  "queues": {
    "producers": [{ "binding": "REMINDERS_QUEUE", "queue": "suluhu-reminders" }],
    "consumers": [{ "queue": "suluhu-reminders", "max_batch_size": 10, "max_retries": 3 }]
  },

  // Scheduled reminder sweeps (replaces the node-cron-style interval in
  // reminders.service.ts). Every 5 minutes; the consumer enforces idempotency
  // per reminder so a missed/late tick never double-sends. Wired in Phase 5.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // Workers Rate Limiting bindings — one *per route*, matching Nest's default
  // `ThrottlerGuard` tracker, which keys on (controller, handler, ip): two
  // routes that happen to share the same `@Throttle(...)` limit/ttl still get
  // independent counters, so these do too, even where several share the same
  // (limit, period) value below. Each called with a `key` per call site (the
  // client IP, matching that same default tracker). The binding's `period`
  // only accepts 10 or 60 seconds, so the OTP-service's own 3-per-15-min
  // issuance throttle (a *different*, longer window) is implemented over
  // AUTH_KV below instead — see src/lib/otp.ts.
  "unsafe": {
    "bindings": [
      // Class-level default (apps/api's `@Throttle({default:{limit:10,ttl:60_000}})`
      // on AuthController): register, logout, password/reset, password/change,
      // and the test-only otp-readback endpoint.
      {
        "name": "RATE_LIMITER_AUTH_REGISTER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 10, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_AUTH_LOGOUT",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 10, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_AUTH_PASSWORD_RESET",
        "type": "ratelimit",
        "namespace_id": "1003",
        "simple": { "limit": 10, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_AUTH_PASSWORD_CHANGE",
        "type": "ratelimit",
        "namespace_id": "1004",
        "simple": { "limit": 10, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_AUTH_TEST_OTP",
        "type": "ratelimit",
        "namespace_id": "1005",
        "simple": { "limit": 10, "period": 60 }
      },
      // AUTH_LOGIN_RATE_LIMIT (5/min): login, google, google/register.
      {
        "name": "RATE_LIMITER_AUTH_LOGIN",
        "type": "ratelimit",
        "namespace_id": "1006",
        "simple": { "limit": 5, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_AUTH_GOOGLE",
        "type": "ratelimit",
        "namespace_id": "1007",
        "simple": { "limit": 5, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_AUTH_GOOGLE_REGISTER",
        "type": "ratelimit",
        "namespace_id": "1008",
        "simple": { "limit": 5, "period": 60 }
      },
      // AUTH_MFA_VERIFY_RATE_LIMIT / AUTH_OTP_VERIFY_RATE_LIMIT (5/min, same value).
      {
        "name": "RATE_LIMITER_AUTH_MFA_VERIFY",
        "type": "ratelimit",
        "namespace_id": "1009",
        "simple": { "limit": 5, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_AUTH_OTP_VERIFY",
        "type": "ratelimit",
        "namespace_id": "1010",
        "simple": { "limit": 5, "period": 60 }
      },
      // AUTH_OTP_REQUEST_RATE_LIMIT / AUTH_PASSWORD_FORGOT_RATE_LIMIT (3/min, same value).
      {
        "name": "RATE_LIMITER_AUTH_OTP_REQUEST",
        "type": "ratelimit",
        "namespace_id": "1011",
        "simple": { "limit": 3, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_AUTH_PASSWORD_FORGOT",
        "type": "ratelimit",
        "namespace_id": "1012",
        "simple": { "limit": 3, "period": 60 }
      },
      // Global app-wide default (RATE_LIMIT_PER_USER_PER_MIN, 100/min): refresh, me, users/me.
      {
        "name": "RATE_LIMITER_AUTH_REFRESH",
        "type": "ratelimit",
        "namespace_id": "1013",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_AUTH_ME",
        "type": "ratelimit",
        "namespace_id": "1014",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_USERS_ME_GET",
        "type": "ratelimit",
        "namespace_id": "1015",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_USERS_ME_PATCH",
        "type": "ratelimit",
        "namespace_id": "1016",
        "simple": { "limit": 100, "period": 60 }
      },
      // Phase 3 — therapists, discovery, admin. None of these controllers
      // carry an explicit `@Throttle(...)` in apps/api, so they all fall
      // back to the same global default (100/min) as RATE_LIMITER_AUTH_REFRESH
      // above — still one binding per route, for the same per-route-tracker
      // reason explained above.
      {
        "name": "RATE_LIMITER_THERAPISTS_CREDENTIALS",
        "type": "ratelimit",
        "namespace_id": "1017",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_THERAPISTS_ONBOARDING",
        "type": "ratelimit",
        "namespace_id": "1018",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_THERAPISTS_AVAILABILITY_GET",
        "type": "ratelimit",
        "namespace_id": "1019",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_THERAPISTS_AVAILABILITY_PUT",
        "type": "ratelimit",
        "namespace_id": "1020",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_THERAPISTS_DOCUMENTS_UPLOAD",
        "type": "ratelimit",
        "namespace_id": "1021",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_THERAPISTS_DOCUMENTS_LIST",
        "type": "ratelimit",
        "namespace_id": "1022",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_THERAPISTS_SEARCH",
        "type": "ratelimit",
        "namespace_id": "1023",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_THERAPISTS_DETAIL",
        "type": "ratelimit",
        "namespace_id": "1024",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_THERAPISTS_DOCUMENT_DOWNLOAD",
        "type": "ratelimit",
        "namespace_id": "1025",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_ADMIN_THERAPISTS_LIST",
        "type": "ratelimit",
        "namespace_id": "1026",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_ADMIN_THERAPISTS_DETAIL",
        "type": "ratelimit",
        "namespace_id": "1027",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_ADMIN_THERAPISTS_REVIEW",
        "type": "ratelimit",
        "namespace_id": "1028",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_ADMIN_THERAPISTS_RATE",
        "type": "ratelimit",
        "namespace_id": "1073",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_ADMIN_ALERTS_LIST",
        "type": "ratelimit",
        "namespace_id": "1029",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_ADMIN_ALERTS_COUNT",
        "type": "ratelimit",
        "namespace_id": "1030",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_ADMIN_ALERTS_ACKNOWLEDGE",
        "type": "ratelimit",
        "namespace_id": "1031",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_ADMIN_ALERTS_RESOLVE",
        "type": "ratelimit",
        "namespace_id": "1032",
        "simple": { "limit": 100, "period": 60 }
      },
      // Phase 4 — intake, appointments/slots, sessions, payments. None of
      // these controllers carry an explicit `@Throttle(...)` in apps/api
      // either, so they all fall back to the same global default (100/min).
      {
        "name": "RATE_LIMITER_INTAKE_SUBMIT",
        "type": "ratelimit",
        "namespace_id": "1033",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_INTAKE_LATEST",
        "type": "ratelimit",
        "namespace_id": "1034",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_INTAKE_HISTORY",
        "type": "ratelimit",
        "namespace_id": "1035",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_THERAPISTS_SLOTS",
        "type": "ratelimit",
        "namespace_id": "1036",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_APPOINTMENTS_CREATE",
        "type": "ratelimit",
        "namespace_id": "1037",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_APPOINTMENTS_LIST",
        "type": "ratelimit",
        "namespace_id": "1038",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_APPOINTMENTS_DETAIL",
        "type": "ratelimit",
        "namespace_id": "1039",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_APPOINTMENTS_CANCEL",
        "type": "ratelimit",
        "namespace_id": "1040",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_SESSIONS_ACCESS",
        "type": "ratelimit",
        "namespace_id": "1041",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_SESSIONS_START",
        "type": "ratelimit",
        "namespace_id": "1042",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_SESSIONS_END",
        "type": "ratelimit",
        "namespace_id": "1043",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_PAYMENTS_MPESA_CALLBACK",
        "type": "ratelimit",
        "namespace_id": "1044",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_PAYMENTS_PAYHERO_CALLBACK",
        "type": "ratelimit",
        "namespace_id": "1045",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_PAYMENTS_STATUS",
        "type": "ratelimit",
        "namespace_id": "1046",
        "simple": { "limit": 100, "period": 60 }
      },
      // Phase 5 — messaging, mood, content, clinical, analytics/payouts.
      // Same story as every prior phase: none of these controllers carry an
      // explicit `@Throttle(...)` in apps/api, so they all use the global
      // default (100/min), one binding per route.
      {
        "name": "RATE_LIMITER_CONVERSATIONS_LIST",
        "type": "ratelimit",
        "namespace_id": "1047",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_CONVERSATIONS_OPEN",
        "type": "ratelimit",
        "namespace_id": "1048",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_CONVERSATIONS_MESSAGES_GET",
        "type": "ratelimit",
        "namespace_id": "1049",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_CONVERSATIONS_MESSAGES_SEND",
        "type": "ratelimit",
        "namespace_id": "1050",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_MOOD_CREATE",
        "type": "ratelimit",
        "namespace_id": "1051",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_MOOD_LIST",
        "type": "ratelimit",
        "namespace_id": "1052",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_CONTENT_LIST",
        "type": "ratelimit",
        "namespace_id": "1053",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_CONTENT_DETAIL",
        "type": "ratelimit",
        "namespace_id": "1054",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_ADMIN_CONTENT_LIST",
        "type": "ratelimit",
        "namespace_id": "1055",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_ADMIN_CONTENT_CREATE",
        "type": "ratelimit",
        "namespace_id": "1056",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_ADMIN_CONTENT_UPDATE",
        "type": "ratelimit",
        "namespace_id": "1057",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_CLINICAL_NOTES_UPSERT",
        "type": "ratelimit",
        "namespace_id": "1058",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_CLINICAL_NOTES_AI_DRAFT",
        "type": "ratelimit",
        "namespace_id": "1059",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_CLINICAL_NOTES_BY_APPOINTMENT",
        "type": "ratelimit",
        "namespace_id": "1060",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_TREATMENT_PLANS_UPSERT",
        "type": "ratelimit",
        "namespace_id": "1061",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_PATIENTS_NOTES",
        "type": "ratelimit",
        "namespace_id": "1062",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_PATIENTS_TREATMENT_PLAN",
        "type": "ratelimit",
        "namespace_id": "1063",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_PATIENTS_HEALTH_RECORD",
        "type": "ratelimit",
        "namespace_id": "1064",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_CLINICAL_CLIENTS",
        "type": "ratelimit",
        "namespace_id": "1065",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_ADMIN_REMINDERS_STATS",
        "type": "ratelimit",
        "namespace_id": "1066",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_ADMIN_METRICS",
        "type": "ratelimit",
        "namespace_id": "1067",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_ADMIN_REVENUE",
        "type": "ratelimit",
        "namespace_id": "1068",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_ADMIN_PAYOUTS_LIST",
        "type": "ratelimit",
        "namespace_id": "1069",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_ADMIN_PAYOUTS_PAY",
        "type": "ratelimit",
        "namespace_id": "1070",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_ADMIN_AUDIT_LOG",
        "type": "ratelimit",
        "namespace_id": "1071",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_ADMIN_PAYMENTS_SETTINGS_GET",
        "type": "ratelimit",
        "namespace_id": "1074",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_ADMIN_PAYMENTS_SETTINGS_UPDATE",
        "type": "ratelimit",
        "namespace_id": "1075",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_ADMIN_SETTINGS_COMMISSION_GET",
        "type": "ratelimit",
        "namespace_id": "1076",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_ADMIN_SETTINGS_COMMISSION_UPDATE",
        "type": "ratelimit",
        "namespace_id": "1077",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_THERAPIST_EARNINGS",
        "type": "ratelimit",
        "namespace_id": "1072",
        "simple": { "limit": 100, "period": 60 }
      }
    ]
  },

  // Ephemeral auth state with a Redis-shaped access pattern (set-with-TTL,
  // get, incr-ish counters) — the access-token revocation blocklist
  // (`access:<jti>`, fail-open on error, same posture as the Redis version it
  // replaces) and the OTP service's 3-per-15-min issuance throttle
  // (`otp-issue:<userId>:<purpose>`, best-effort — KV is eventually
  // consistent, acceptable for an anti-abuse counter, not a correctness
  // guarantee). Create with `wrangler kv namespace create suluhu-api-auth`.
  "kv_namespaces": [{ "binding": "AUTH_KV", "id": "ba164483c4bf421cbae53e1ab0d7e9dd" }],

  // Non-secret config. Secrets (JWT, PHI key, provider credentials, Resend
  // API key, Google client id, ...) are set with `wrangler secret put` — see
  // apps/api-worker/README.md for the full list.
  "vars": {
    "API_PUBLIC_URL": "https://api.suluhutherapy.com",
    "CORS_ORIGINS": "https://suluhutherapy.com,https://www.suluhutherapy.com,https://suluhutherapy.co.ke,http://localhost:3000",
    "PROVIDER_MODE": "mock",
    "MPESA_MODE": "mock",
    "VIDEO_MODE": "live",
    "AI_MODE": "mock",
    "SMS_MODE": "mock",
    "EMAIL_MODE": "live",
    "EMAIL_FROM": "Suluhu Therapy <no-reply@suluhutherapy.com>",
    "BEFRIENDERS_KENYA_HOTLINE": "0800723253"
  }
}
