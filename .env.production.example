# Production configuration for the single-host Docker stack
# (docker-compose.prod.yml). Copy to .env.production on the server, fill in,
# and keep it out of git — it holds the keys that decrypt clinical data.
#
# Generate the secrets on the server:
#   openssl rand -base64 48   # JWT_ACCESS_SECRET, JWT_REFRESH_SECRET
#   openssl rand -base64 32   # PHI_ENCRYPTION_KEY (must decode to exactly 32 bytes)
#   openssl rand -base64 24   # POSTGRES_PASSWORD, REDIS_PASSWORD

NODE_ENV=production
TZ=Africa/Nairobi

# --- Domains (Cloudflare DNS, proxied, SSL mode "Full (strict)") -------------
# suluhutherapy.co.ke is served from this VPS; suluhutherapy.com 301-redirects
# to it (see deploy/Caddyfile). If you only register one domain, drop
# WEB_DOMAIN_REDIRECT and its Caddyfile block.
# When the web app is served from Cloudflare Workers on suluhutherapy.com
# (apps/web/CLOUDFLARE.md), remove suluhutherapy.com from Caddy's redirect
# block — the Worker owns that hostname — and add it to CORS_ORIGINS below.
WEB_DOMAIN=suluhutherapy.co.ke
API_DOMAIN=api.suluhutherapy.co.ke
WEB_DOMAIN_REDIRECT=suluhutherapy.com

API_PUBLIC_URL=https://api.suluhutherapy.co.ke
# Every origin that serves the web app (comma-separated). Includes the
# Cloudflare Workers frontend on suluhutherapy.com.
CORS_ORIGINS=https://suluhutherapy.co.ke,https://suluhutherapy.com,https://www.suluhutherapy.com

# --- Datastores (reached over the compose network, never published) ----------
POSTGRES_USER=suluhu
POSTGRES_PASSWORD=
POSTGRES_DB=suluhu
DATABASE_URL=postgresql://suluhu:PASSWORD@postgres:5432/suluhu?schema=public
# Prisma migrate/introspect. Same as DATABASE_URL here; a pooled provider needs the direct endpoint.
DIRECT_URL=postgresql://suluhu:PASSWORD@postgres:5432/suluhu?schema=public

REDIS_PASSWORD=
REDIS_URL=redis://:PASSWORD@redis:6379

# --- Secrets — unique to production, never reused from .env.example ----------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Rotating this after clinical data exists makes existing notes undecryptable. Back it up.
PHI_ENCRYPTION_KEY=

# --- Providers: flip to live once the credentials below are filled in --------
PROVIDER_MODE=live
MPESA_MODE=mock
VIDEO_MODE=mock
AI_MODE=mock
SMS_MODE=mock
EMAIL_MODE=mock

# M-Pesa via PayHero (MPESA_MODE=live)
MPESA_CALLBACK_URL=https://api.suluhutherapy.co.ke/api/v1/payments/mpesa/callback
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=

# Daily.co video (VIDEO_MODE=live)
DAILY_API_KEY=
DAILY_DOMAIN=

# Africa's Talking SMS — carries therapist/admin login OTPs (SMS_MODE=live)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# SMTP email, e.g. Resend (EMAIL_MODE=live)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Suluhu Therapy Center <no-reply@suluhutherapy.co.ke>"

BEFRIENDERS_KENYA_HOTLINE=0800723253

# Mounted volume in docker-compose.prod.yml — do not point at the image filesystem.
DOCUMENT_STORAGE_DIR=/data/therapist-documents

# Sign in with Google — OAuth Web client ID (not a secret). Used by the API to
# verify ID tokens and baked into the web build. Blank disables Google login.
GOOGLE_CLIENT_ID=
